import json
import os
import time

from google.auth.transport.requests import Request
from google.oauth2.credentials import Credentials
from google_auth_oauthlib.flow import InstalledAppFlow
from googleapiclient.discovery import build
from googleapiclient.http import MediaInMemoryUpload

# Solo pedimos la carpeta privada de Quipu en Drive
PERMISOS = ["https://www.googleapis.com/auth/drive.appdata"]

CARPETA_QUIPU = os.path.join(os.environ["APPDATA"], "Quipu")
RUTA_TOKEN = os.path.join(CARPETA_QUIPU, "token_google.json")
RUTA_CREDENCIALES = "credenciales_google.json"
NOMBRE_PRUEBA = "prueba_quipu.json"


def iniciar_sesion():
    """Devuelve la llave de Google: la guardada si sirve, o pide entrar de nuevo."""
    llave = None
    if os.path.exists(RUTA_TOKEN):
        llave = Credentials.from_authorized_user_file(RUTA_TOKEN, PERMISOS)

    if not llave or not llave.valid:
        # Si la llave venció pero se puede renovar, se renueva sin molestar
        if llave and llave.expired and llave.refresh_token:
            try:
                llave.refresh(Request())
            except Exception:
                llave = None  # pasa en modo Prueba cada 7 días: hay que entrar de nuevo

        # Si no hay llave que sirva, se abre el navegador para entrar con Google
        if not llave or not llave.valid:
            flujo = InstalledAppFlow.from_client_secrets_file(RUTA_CREDENCIALES, PERMISOS)
            llave = flujo.run_local_server(
                port=0,
                success_message="Listo, ya podés cerrar esta pestaña y volver a Quipu.",
            )

        # Se guarda la llave para no pedir permiso cada vez
        os.makedirs(CARPETA_QUIPU, exist_ok=True)
        with open(RUTA_TOKEN, "w", encoding="utf-8") as archivo:
            archivo.write(llave.to_json())

    return llave


def buscar_archivo(drive, nombre):
    """Busca un archivo por nombre en la carpeta privada. Devuelve su id o None."""
    respuesta = drive.files().list(
        spaces="appDataFolder",
        q=f"name = '{nombre}'",
        fields="files(id, name)",
    ).execute()
    archivos = respuesta.get("files", [])
    return archivos[0]["id"] if archivos else None


def main():
    llave = iniciar_sesion()
    drive = build("drive", "v3", credentials=llave)
    print("Sesión iniciada con Google.")

    # 1. Subir (o actualizar) un archivo de prueba
    contenido = json.dumps({"mensaje": "Hola desde Quipu", "hora": time.time()})
    media = MediaInMemoryUpload(contenido.encode("utf-8"), mimetype="application/json")

    id_archivo = buscar_archivo(drive, NOMBRE_PRUEBA)
    if id_archivo:
        drive.files().update(fileId=id_archivo, media_body=media).execute()
        print("Archivo de prueba actualizado.")
    else:
        datos = {"name": NOMBRE_PRUEBA, "parents": ["appDataFolder"]}
        id_archivo = drive.files().create(body=datos, media_body=media, fields="id").execute()["id"]
        print("Archivo de prueba creado.")

    # 2. Listar lo que hay en la carpeta privada
    print("\nArchivos en la carpeta de Quipu en Drive:")
    lista = drive.files().list(
        spaces="appDataFolder",
        fields="files(id, name, modifiedTime, size)",
    ).execute()
    for archivo in lista.get("files", []):
        print(f"   {archivo['name']}  ({archivo.get('size', '?')} bytes, {archivo['modifiedTime']})")

    # 3. Bajarlo y leerlo, para confirmar que vuelve igual
    bajado = drive.files().get_media(fileId=id_archivo).execute()
    print("\nContenido bajado:", bajado.decode("utf-8"))


if __name__ == "__main__":
    main()